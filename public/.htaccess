# SPA fallback: serve index.html for any route that isn't a real file/folder,
# so React Router (BrowserRouter) can handle it on refresh/direct-load.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
